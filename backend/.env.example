# Database Connection (PostgreSQL 15+)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/reconai

# Authentication & Security (Backend Only - NEVER expose to frontend or public git)
DEMO_ACCESS_PASSWORD=change_this_demo_password_in_production
JWT_SECRET=change_this_jwt_signing_secret_min_32_characters_long
SESSION_TOKEN_TTL_HOURS=8

# AI Service (Optional - NullAdapter fallback used if unset)
GEMINI_API_KEY=

# File Storage
UPLOAD_DIR=uploads

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000

# Application Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
